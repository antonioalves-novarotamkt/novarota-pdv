DATABASE_URL="postgresql://user:password@localhost:5432/menumanager"
JWT_SECRET="sua-chave-secreta-super-segura-aqui-min-32-caracteres"
NODE_ENV="development"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# URL pública do frontend, usada no link do email de "esqueci minha senha".
# Se ficar vazio, usa a primeira origem de CORS_ORIGIN.
APP_URL="http://localhost:5173"

# SMTP para enviar emails (mesmas variáveis do NovaRotaAdm).
# Sem EMAIL_SERVER_HOST, em desenvolvimento o link de redefinição aparece no log do servidor.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Cardápio NovaRota <nao-responda@seudominio.com.br>"
