generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Produto {
  id        String        @id @default(cuid())
  pdvId     Int?          @unique
  nome      String
  descricao String?
  preco     Float
  categoria String        @default("Cardapio")
  ativo     Boolean       @default(true)
  ordem     Int           @default(0)
  criadoEm  DateTime      @default(now())
  itens     PedidoItem[]
}

model ConfiguracaoLoja {
  id              String   @id @default("config")
  nomeFantasia    String   @default("")
  telefone        String   @default("")
  enderecoLoja    String   @default("")
  latitudeLoja    Float?
  longitudeLoja   Float?
  pedidoMinimo    Float    @default(0)
  tempoEstimadoMin Int     @default(45)
  aceitandoPedidos Boolean @default(true)
  atualizadoEm    DateTime @updatedAt
}

/// Camada de raio de entrega (estilo iFood): "ate X km" do endereco da loja, com tempo e taxa
/// proprios. A distancia do cliente e calculada por geocoding (Mapbox) + linha reta (haversine)
/// a partir do endereco confirmado no checkout.
model AreaEntrega {
  id               String   @id @default(cuid())
  raioKm           Float    @default(1)
  taxa             Float
  tempoEstimadoMin Int      @default(45)
  ativo            Boolean  @default(true)
  criadoEm         DateTime @default(now())

  @@index([raioKm])
}

enum StatusPedido {
  recebido
  preparo
  saiu_entrega
  entregue
  cancelado
}

enum FormaPagamentoPedido {
  dinheiro
  cartao_entrega
}

model Pedido {
  id               String                @id @default(cuid())
  clienteNome      String
  clienteTelefone  String
  cep              String
  rua              String
  numero           String
  semNumero        Boolean               @default(false)
  complemento      String?
  bairro           String
  cidade           String
  uf               String
  pontoReferencia  String?
  latitude         Float?
  longitude        Float?
  distanciaKm      Float?
  taxaEntrega      Float
  totalProdutos    Float
  total            Float
  formaPagamento   FormaPagamentoPedido
  trocoPara        Float?
  observacoes      String?
  status           StatusPedido          @default(recebido)
  sincronizadoPdv  Boolean               @default(false)
  criadoEm         DateTime              @default(now())
  itens            PedidoItem[]
}

model PedidoItem {
  id             String   @id @default(cuid())
  pedido         Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  pedidoId       String
  produto        Produto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  produtoId      String?
  nomeProduto    String
  quantidade     Int
  precoUnitario  Float
}
