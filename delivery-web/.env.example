# Postgres (Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host:5432/novarota_delivery"

# Senha do painel administrativo (cadastro de produtos e configuracao de frete)
ADMIN_PASSWORD="troque-esta-senha"

# Segredo usado para assinar o cookie de sessao do admin
SESSION_SECRET="gere-uma-string-aleatoria-longa"

# Token que o PDV desktop usa para buscar pedidos pendentes (gere um valor aleatorio
# e configure o mesmo valor em Configuracoes > Delivery no PDV)
PDV_SYNC_TOKEN="gere-outro-valor-aleatorio"

# Token publico do Mapbox (crie uma conta gratis em https://account.mapbox.com/ e copie o
# "Default public token"). Usado para o mapa de raio de entrega no admin e o mapa de
# confirmacao de endereco no checkout, alem da geocodificacao de endereco (Mapbox Geocoding API).
# As duas variaveis abaixo devem ter o MESMO valor -- a com NEXT_PUBLIC_ fica exposta no
# navegador (necessario para o mapa renderizar), a outra e usada nas rotas de servidor.
MAPBOX_TOKEN="pk.seu-token-publico-do-mapbox"
NEXT_PUBLIC_MAPBOX_TOKEN="pk.seu-token-publico-do-mapbox"
